# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Database ──────────────────────────────────────────────────────────────────
# Local Postgres (no Docker) — install PostgreSQL 15/16 (pgvector NOT required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customer_support
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/customer_support

# ── Pinecone ─────────────────────────────────────────────────────────────────
# Create a FREE Serverless index at https://app.pinecone.io
#   Dimension : 1536
#   Metric    : cosine
#   Cloud     : aws  |  Region: us-east-1
PINECONE_API_KEY=pcsk_...your-key-here...
PINECONE_INDEX_NAME=customer-support-kb
PINECONE_NAMESPACE=documents

# ── API Security ──────────────────────────────────────────────────────────────
API_SECRET_KEY=change-me-in-production-32chars-min

# ── App Settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Agent Settings ───────────────────────────────────────────────────────────
MAX_ITERATIONS=10
ESCALATION_THRESHOLD=3          # failed tool calls before escalate
REFUND_LIMIT_USD=500            # max refund an agent can approve
